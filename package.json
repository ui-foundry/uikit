{
	"name": "uikit-workspace",
	"version": "1.0.0",
	"description": "A design system for everyone",
	"workspaces": [
		"docs",
		"packages/*"
	],
	"scripts": {
		"docs:dev": "pnpm --filter docs dev",
		"docs:deploy": "pnpm --filter docs build && gh-pages -d docs/dist",
		"example:react": "pnpm --filter react dev",
		"prepare": "lefthook install",
		"format": "biome format --write",
		"clean": "run-s clean:*",
		"clean:build": "rimraf .stencil dist **/*/dist",
		"clean:modules": "rimraf node_modules **/*/node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@stencil/vue-output-target": "^0.11.8",
		"@types/node": "^22.17.0",
		"gh-pages": "^6.3.0",
		"lefthook": "1.12.2",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=20.10.0",
		"pnpm": ">=9.4.0"
	},
	"packageManager": "pnpm@10.12.4"
}
