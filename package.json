{
	"name": "uikit-workspace",
	"version": "1.0.0",
	"description": "A design system for everyone",
	"workspaces": [
		"docs",
		"packages/*"
	],
	"scripts": {
		"dev:docs": "bun --filter docs dev",
		"prepare": "bunx lefthook install",
		"format": "bunx biome format --write",
		"clean": "run-s clean:*",
		"clean:build": "rimraf .stencil dist **/*/dist",
		"clean:modules": "rimraf node_modules **/*/node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@stencil/vue-output-target": "^0.11.8",
		"@types/bun": "latest",
		"@types/node": "^22.17.0",
		"lefthook": "1.12.2",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3"
	},
	"engines": {
		"bun": ">=1.0.0"
	},
	"packageManager": "bun@1.1.8"
}
